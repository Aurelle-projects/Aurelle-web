# =============================================================
# AURELLE COSMETICS — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# -------------------------------------------------------------
# SUPABASE
# Get these from: https://app.supabase.com → Project Settings → API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# SERVICE ROLE KEY — SERVER ONLY. NEVER expose to client.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# -------------------------------------------------------------
# STRIPE
# Get these from: https://dashboard.stripe.com → Developers → API keys
# Use TEST keys during development (sk_test_..., pk_test_...)
# Switch to LIVE keys only for production launch
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# -------------------------------------------------------------
# CLOUDINARY
# Get these from: https://cloudinary.com → Dashboard → API Keys
# CLOUDINARY_API_SECRET — SERVER ONLY. NEVER expose to client.
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=aurelle_products

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------
# BREVO — PASSWORD RESET EMAILS ONLY
# Get the API key from: https://app.brevo.com → SMTP & API → API Keys
# BREVO_API_KEY and BREVO_SENDER_EMAIL are server-only values.
# -------------------------------------------------------------
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@aurelle.ae
BREVO_SENDER_NAME=Aurelle

# -------------------------------------------------------------
# ADMIN CONSOLE CREDENTIALS
# -------------------------------------------------------------
ADMIN_EMAIL=admin@aurelle.ae
ADMIN_PASSWORD=admin123

# =============================================================
# PRODUCTION CHECKLIST
# Before going live:
# 1. Replace all test Stripe keys with live keys
# 2. Register and verify the Stripe webhook endpoint
# 3. Set NEXT_PUBLIC_SITE_URL to production domain
# 4. Ensure SUPABASE_SECRET_KEY is set only in Vercel env vars (not NEXT_PUBLIC)
# 5. Rotate secrets if any were accidentally exposed
# =============================================================
